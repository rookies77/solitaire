{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compiler tout le projet",
      "type": "shell",
      "command": "javac",
      "args": [
        "--release",
        "21",
        "-d",
        "bin",
        "-sourcepath",
        "src",
        "src/interfaceGraphique/*.java",
        "src/*.java",
        "src/testInterfaceGraphique/*.java"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": ["$javac"]
    }
  ]
}
